{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "formatter": true,
  "lsp": true,
  "permission": {},
  "provider": {
    "MLX": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "MLX (local)",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
      },
      "models": {
        "Blarfursnarg/OxCoder-9B-mlx": {
          "name": "OxCoder-9B (local)",
          "options": {
            "repetition_penalty": 1.15,
            "repetition_context_size": 64,
          },
        },
      },
    },
    "amazon-bedrock": {
      "options": {
        "region": "eu-west-1",
        "profile": "gorilla-tools-formulas",
      },
    },
  },
  "share": "disabled",
}
